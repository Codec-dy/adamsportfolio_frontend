---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { Title = 'Sprout Designs' } = Astro.props;
---

<section class="relative min-h-screen w-full overflow-hidden pt-30">
  <!-- Gradient Background -->
  <div class="absolute inset-0 bg-gradient-to-tr from-pink-300 via-purple-300 to-blue-300 opacity-60 blur-3xl"></div>

  <!-- Content goes above -->
  <div class="relative z-2 text-center">
    <main class="">
        <slot />
      
    </main>
  </div>
</section>

<script>
  // Optional: Add any JavaScript functionality here
const adminToken = sessionStorage.getItem('adminToken');
// console.log(window.location.pathname.replace('/',''), adminToken);
console.log((adminToken && window.location.pathname.replace('/','') !== 'admin'));

if ((!adminToken && window.location.pathname.replaceAll('/','') !== 'admin') ) {
    window.location.href = '/admin/'; // Redirect to login if not authenticated
}
</script>