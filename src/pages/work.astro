---
import MainLayout from "../layouts/MainLayout.astro";
import Layout2 from "../layouts/Layout2.astro";
import MainWorkCatCard from "../components/MainWorkCatCard.astro";
import Title from "../components/Title.astro";
---

<MainLayout>
    <Layout2>
        <div class="flex flex-col min-w-fit w-screen max-w-[1200px] justify-self-center gap-2 bg-white p-5 sm:p-20">
            
        <Title title="Portfolio Categories" />
        <div class="flex flex-col sm:flex-row  justify-center gap-4 ">
            <div class="flex flex-1 flex-col sm:mt-[50px]  sm:max-w-[500px] w-full">
            <MainWorkCatCard
                title="Projects"
                description="Building responsive and dynamic websites."
                image="/projects2.jpg"
                link="/projects"
                
                />
                <MainWorkCatCard
                title="Photography"
                description="Building responsive and dynamic websites."
                image="/photo2.jpg"
                link="/photography"
                />
                <MainWorkCatCard
                title="Painting"
                description="Building responsive and dynamic websites."
                image="/image2.jpg"
                link="/painting"
                />
            </div>
            <div class="flex flex-1 flex-col  max-w-[500px] w-full">
                <MainWorkCatCard
                title="Illustration"
                description="Building responsive and dynamic websites."
                image="/illust2.jpg"
                link="/illustrations"
                />
                
                <MainWorkCatCard
                title="Trading Cards"
                description="Building responsive and dynamic websites."
                image="/tc.jpg"
                link="/tradingcards"
                />
            </div>
        </div>
        </div>
    </Layout2>
</MainLayout>