---
import MainLayout from "../../../layouts/MainLayout.astro"
import Layout2_admin from "../../../layouts/Layout2_admin.astro"

import AdminLayout from "../../../layouts/AdminLayout.astro"
import Button from "../../../components/Button"
import ProjectPopUp2 from "../../../components/admin/ProjectPopUp2"
import { splitImages } from "../../../utils/functions"
import { getData } from "../../../utils/crud"
import Rows from "../../../components/Rows.astro"
import { handleEdit } from "../../../utils/crud"
const {api} = Astro.locals; 
const { id } = Astro.params;
const project= await getData(api+"?model=project&id="+id) || []; // Fetching photography projects by id
console.log(project);

---

<AdminLayout>
    <div>
        <div class='flex  flex-col gap-2 p-6'>
            <div class='flex flex-col justify-between items-start'>
                <h1 class='text-2xl font-semibold mb-4'><a href="/admin/projects"><img src="/arrow_back.png"/></a></h1>
                <ProjectPopUp2 title={""} id={id} elements={project.elements}  client:load/>
            </div> 
            <div class="flex flex-col gap-2">
            {splitImages(project.elements).map((arr, index) => (
                <Rows images={arr} key={index} id={id} isAdmin="true" />
            ))
            }
            </div>
        </div>
    </div>
    
</AdminLayout>

<script>
  // Optional: Add any JavaScript functionality here
const adminToken = sessionStorage.getItem('adminToken');
// console.log(window.location.pathname.replace('/',''), adminToken);
console.log((adminToken && window.location.pathname.replace('/','') !== 'admin'));

if ((!adminToken && window.location.pathname.replaceAll('/','') !== 'admin') ) {
    window.location.href = '/admin/'; // Redirect to login if not authenticated
}
</script>
